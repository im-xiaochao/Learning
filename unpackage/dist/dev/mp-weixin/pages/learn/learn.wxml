<view class="learn page"><view class="lv-top"><view class="lv-back" hover-class="hover-press" role="button" aria-label="退出学习并返回上一页" bindtap="{{a}}"><text class="lv-icon-text">‹</text><text class="lv-back-label">返回</text></view><text class="lv-counter">{{b}}</text><view class="lv-top-right"><text wx:if="{{c}}" class="lv-round">复习</text><text wx:elif="{{d}}" class="lv-round">错词学习</text><text wx:elif="{{e}}" class="lv-round">认词 {{f}}/{{g}} 轮</text><text wx:elif="{{h}}" class="lv-round">拼写</text><text wx:elif="{{i}}" class="lv-round">学习</text></view></view><view class="lv-progress" aria-label="当前步骤进度"><view class="lv-progress-fill" style="{{'width:' + j}}"/></view><view wx:if="{{k}}" class="lv-body"><view class="study-area"><view class="study-card"><text class="study-card-label">先建立记忆</text><view class="w-word">{{l}}</view><view class="w-phonetic"><text class="w-chip">美</text><text class="w-phonetic-text">{{m}}</text></view><view wx:if="{{n}}" key="m" class="study-meaning masked" role="button" aria-label="点击查看释义" bindtap="{{o}}"><text>点击查看释义</text></view><view wx:else key="s" class="study-meaning" hover-class="hover-press" role="button" aria-label="点击隐藏释义" bindtap="{{r}}"><text class="opt-pos">{{p}}</text><text>{{q}}</text></view></view></view><view class="study-nav"><view class="{{['nav-btn', s && 'disabled']}}" hover-class="hover-press" role="button" aria-label="上一个单词" bindtap="{{t}}"><text class="nav-btn-arrow">‹</text><text class="nav-btn-text">上一个</text></view><view class="{{['nav-btn', v && 'disabled']}}" hover-class="hover-press" role="button" aria-label="下一个单词" bindtap="{{w}}"><text class="nav-btn-text">下一个</text><text class="nav-btn-arrow">›</text></view></view><view class="lv-cta" role="button" aria-label="开始认词测试" bindtap="{{x}}"><text class="lv-cta-text">开始认词</text></view></view><view wx:elif="{{y}}" class="lv-body"><view class="w-head"><view class="w-word recall-word">{{z}}</view><view class="w-phonetic"><text class="w-chip">美</text><text class="w-phonetic-text">{{A}}</text></view><text class="w-hint">先回想词义再选择，想不起来「看答案」</text></view><view class="w-options"><view wx:for="{{B}}" wx:for-item="opt" wx:key="e" class="{{['w-option', 'fade-in', opt.f && 'correct', opt.g && 'wrong', opt.h && 'dim']}}" aria-label="{{opt.i}}" bindtap="{{opt.j}}"><text class="opt-pos">{{opt.a}}</text><text class="opt-text">{{opt.b}}</text><text wx:if="{{opt.c}}" class="opt-state correct-state">正确答案</text><text wx:elif="{{opt.d}}" class="opt-state wrong-state">你的选择</text></view></view><view class="w-bottom"><view wx:if="{{C}}" class="reveal-btn" role="button" aria-label="查看答案并标记为不认识" bindtap="{{D}}"><text class="reveal-text">看答案</text></view><block wx:elif="{{E}}"><text class="fb-no">{{F}}</text><view class="lv-cta small" role="button" aria-label="{{H}}" bindtap="{{I}}"><text class="lv-cta-text">{{G}}</text></view></block><block wx:else><text class="fb-ok">{{J}}</text><view class="lv-cta small" role="button" aria-label="{{L}}" bindtap="{{M}}"><text class="lv-cta-text">{{K}}</text></view></block></view></view><view wx:elif="{{N}}" class="lv-body"><view class="w-head"><view class="w-phonetic spell-phonetic"><text class="w-chip">美</text><text class="w-phonetic-text">{{O}}</text></view><text class="spell-hint"><text class="opt-pos">{{P}}</text>{{Q}}</text></view><view class="{{['slots', S]}}"><view wx:for="{{R}}" wx:for-item="i" wx:key="b" class="{{['slot', i.c && 'filled']}}" role="button" aria-label="{{i.d}}" bindtap="{{i.e}}"><text>{{i.a}}</text></view></view><view class="pool"><view wx:for="{{T}}" wx:for-item="p" wx:key="b" class="{{['pool-item', p.c && 'used']}}" role="button" aria-label="{{p.d}}" bindtap="{{p.e}}"><text>{{p.a}}</text></view></view></view><view wx:else class="lv-body result-body"><view class="result-card"><text class="result-icon">✓</text><text class="result-title">{{U}}</text><text class="result-desc">{{V}}</text><view class="lv-cta" role="button" aria-label="继续下一组学习" bindtap="{{X}}"><text class="lv-cta-text">{{W}}</text></view><view class="lv-ghost" hover-class="hover-press" role="button" aria-label="返回首页" bindtap="{{Y}}"><text class="lv-ghost-text">返回首页</text></view></view></view><view wx:if="{{Z}}" class="toast" role="status" aria-live="polite"><text class="toast-text">{{aa}}</text></view></view>
/* ══ 按压反馈（H5 走 :active；小程序端由 hover-class 提供，见模板） ══ */
.chapter-head.data-v-ce9408c1,
.section-head.data-v-ce9408c1,
.point-head.data-v-ce9408c1,
.map-node.data-v-ce9408c1,
.no-results-btn.data-v-ce9408c1,
.module-tab.data-v-ce9408c1,
.search-clear.data-v-ce9408c1 {
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.chapter-head.data-v-ce9408c1:active,
.section-head.data-v-ce9408c1:active,
.point-head.data-v-ce9408c1:active,
.map-node.data-v-ce9408c1:active,
.no-results-btn.data-v-ce9408c1:active,
.module-tab.data-v-ce9408c1:active,
.search-clear.data-v-ce9408c1:active {
  opacity: 0.72;
  transform: scale(0.99);
}
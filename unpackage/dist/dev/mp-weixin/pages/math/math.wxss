/* ══ 布局骨架 ══ */
.math.data-v-ce9408c1 {
  min-height: 100vh;
  padding: calc(var(--status-bar-height, 0px) + 12px) 20px calc(78px + env(safe-area-inset-bottom, 0px));
  box-sizing: border-box;
}
.math-top.data-v-ce9408c1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.math-breadcrumb.data-v-ce9408c1 {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2px;
}
.math-breadcrumb-text.data-v-ce9408c1 {
  color: var(--muted);
  font-size: 12px;
}

/* 小号强调标签（kicker）：统一一处定义 */
.math-kicker.data-v-ce9408c1,
.hero-eyebrow.data-v-ce9408c1,
.part-eyebrow.data-v-ce9408c1,
.overview-eyebrow.data-v-ce9408c1,
.map-heading.data-v-ce9408c1 {
  color: var(--accent-strong);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

/* ══ 顶部 Hero 卡 ══ */
.math-hero.data-v-ce9408c1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 142px;
  margin-top: 10px;
  padding: 20px 19px;
  overflow: hidden;
  background: var(--card-raised);
}
.math-hero-copy.data-v-ce9408c1 {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8px;
}
.math-title.data-v-ce9408c1 {
  color: var(--text);
  font-size: 24px;
  font-weight: 800;
  line-height: 1.3;
}
.math-hero-desc.data-v-ce9408c1 {
  max-width: 245px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}
.hero-symbol.data-v-ce9408c1 {
  position: relative;
  display: flex;
  width: 70px;
  height: 70px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 41px;
  font-weight: 800;
}
.hero-symbol-small.data-v-ce9408c1 {
  position: absolute;
  right: 7px;
  bottom: 6px;
  color: var(--success);
  font-size: 13px;
}

/* ══ 模块切换 ══ */
.module-tabs.data-v-ce9408c1 {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  padding: 5px;
  border-radius: 14px;
  background: var(--card);
  box-shadow: var(--shadow);
}
.module-tab.data-v-ce9408c1 {
  display: flex;
  min-height: 52px;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2px;
  border-radius: 10px;
  color: var(--muted);
}
.module-tab.on.data-v-ce9408c1 {
  background: var(--accent-strong);
  color: var(--on-accent);
  box-shadow: var(--shadow-lg);
}
.tab-name.data-v-ce9408c1 {
  font-size: 15px;
  font-weight: 800;
}
.tab-detail.data-v-ce9408c1 {
  font-size: 11px;
  opacity: 0.8;
}

/* ══ 搜索 ══ */
.math-search.data-v-ce9408c1 {
  display: flex;
  min-height: 48px;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding: 0 11px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--card);
  box-shadow: var(--shadow);
}
.search-icon.data-v-ce9408c1 {
  color: var(--accent-strong);
  font-size: 20px;
}
.search-input.data-v-ce9408c1 {
  height: 46px;
  flex: 1;
  color: var(--text);
  font-size: 16px;
}
.search-clear.data-v-ce9408c1 {
  display: flex;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--card-soft);
  color: var(--muted);
  font-size: 17px;
}
.search-result.data-v-ce9408c1 {
  display: block;
  margin: 8px 2px 0;
  color: var(--accent-strong);
  font-size: 12px;
  line-height: 1.55;
}

/* ══ 模块总览 ══ */
.module-overview.data-v-ce9408c1 {
  margin-top: 12px;
  padding: 15px;
}
.overview-top.data-v-ce9408c1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.overview-title.data-v-ce9408c1 {
  display: block;
  margin-top: 4px;
  color: var(--text);
  font-size: 17px;
  font-weight: 800;
}
.overview-orbit.data-v-ce9408c1 {
  display: flex;
  width: 49px;
  height: 49px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--accent);
  border-radius: 50%;
  color: var(--accent-strong);
  font-size: 11px;
  font-weight: 800;
}
.overview-metrics.data-v-ce9408c1 {
  display: flex;
  margin-top: 14px;
  border-top: 1px solid var(--card-soft);
  border-bottom: 1px solid var(--card-soft);
}
.overview-metric.data-v-ce9408c1 {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
  padding: 11px 3px;
  border-right: 1px solid var(--card-soft);
}
.overview-metric.data-v-ce9408c1:last-child {
  border-right: 0;
}
.overview-metric-number.data-v-ce9408c1 {
  color: var(--text);
  font-size: 20px;
  font-weight: 800;
}
.overview-metric-label.data-v-ce9408c1 {
  margin-top: 3px;
  color: var(--muted);
  font-size: 11px;
}
.overview-tip.data-v-ce9408c1 {
  display: block;
  margin-top: 11px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}

/* ══ 空结果 ══ */
.no-results.data-v-ce9408c1 {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 7px;
  margin-top: 14px;
  padding: 24px 16px;
  text-align: center;
}
.no-results-icon.data-v-ce9408c1 {
  color: var(--accent-strong);
  font-size: 28px;
}
.no-results-title.data-v-ce9408c1 {
  color: var(--text);
  font-size: 16px;
  font-weight: 800;
}
.no-results-copy.data-v-ce9408c1 {
  color: var(--muted);
  font-size: 12px;
}
.no-results-btn.data-v-ce9408c1 {
  margin-top: 6px;
  padding: 8px 12px;
  border-radius: 9px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 12px;
  font-weight: 700;
}

/* ══ 部分（Part） ══ */
.part-block.data-v-ce9408c1 {
  margin-top: 18px;
}
.part-heading.data-v-ce9408c1 {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}
.part-heading-main.data-v-ce9408c1 {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
}
.part-index.data-v-ce9408c1,
.chapter-index.data-v-ce9408c1 {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-weight: 800;
}
.part-index.data-v-ce9408c1 {
  width: 31px;
  height: 31px;
  border-radius: 10px;
  font-size: 11px;
}
.part-title.data-v-ce9408c1 {
  display: block;
  margin-top: 3px;
  color: var(--text);
  font-size: 16px;
  font-weight: 800;
}
.part-count.data-v-ce9408c1 {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 11px;
}

/* ══ 章（Chapter） ══ */
.chapter.data-v-ce9408c1 {
  margin-bottom: 12px;
  overflow: hidden;
}
.chapter-head.data-v-ce9408c1 {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 13px 14px;
}
.chapter-index.data-v-ce9408c1 {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  font-size: 12px;
}
.chapter-copy.data-v-ce9408c1,
.section-copy.data-v-ce9408c1,
.point-copy.data-v-ce9408c1 {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
.chapter-copy.data-v-ce9408c1 {
  gap: 4px;
}
.chapter-title.data-v-ce9408c1 {
  color: var(--text);
  font-size: 15px;
  font-weight: 800;
  line-height: 1.35;
}
.chapter-subtitle.data-v-ce9408c1,
.section-subtitle.data-v-ce9408c1,
.point-subtitle.data-v-ce9408c1 {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.45;
}
.chapter-arrow.data-v-ce9408c1 {
  flex-shrink: 0;
  color: var(--accent-strong);
  font-size: 22px;
  font-weight: 300;
}

/* ══ 章节关系图：本章卡片 + 可换行的模块节点，模块再多也不会越界 ══ */
.map-area.data-v-ce9408c1 {
  padding: 12px 12px 10px;
  border-top: 1px solid var(--card-soft);
  background: var(--card-soft);
}
.map-heading.data-v-ce9408c1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin: 0 3px 8px;
}
.map-heading > text.data-v-ce9408c1:last-child {
  color: var(--muted);
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0;
}
.chapter-map.data-v-ce9408c1 {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 11px;
  border-radius: 14px;
  background: var(--card);
}
.map-core.data-v-ce9408c1 {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px;
  padding: 9px 11px;
  border-radius: 11px;
  background: var(--accent-strong);
  color: var(--on-accent);
  box-shadow: var(--shadow-lg);
}
.map-core-index.data-v-ce9408c1 {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 800;
}
.map-core-title.data-v-ce9408c1 {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 12px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.map-core-meta.data-v-ce9408c1 {
  flex-shrink: 0;
  color: var(--on-accent-muted);
  font-size: 11px;
}
.map-nodes.data-v-ce9408c1 {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.map-node.data-v-ce9408c1 {
  display: flex;
  width: calc(50% - 3px);
  min-width: 0;
  min-height: 34px;
  flex: 0 1 auto;
  align-items: center;
  gap: 7px;
  padding: 6px 10px;
  border: 1px solid var(--accent);
  border-radius: 10px;
  background: var(--card);
  color: var(--text);
}
.map-node.selected.data-v-ce9408c1 {
  border-color: var(--accent-strong);
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.map-node-index.data-v-ce9408c1 {
  display: flex;
  width: 19px;
  height: 19px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 11px;
  font-weight: 800;
}
.map-node.selected .map-node-index.data-v-ce9408c1 {
  background: var(--accent-strong);
  color: var(--on-accent);
}
.map-node-label.data-v-ce9408c1 {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.map-legend.data-v-ce9408c1 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  margin-top: 8px;
  color: var(--muted);
  font-size: 11px;
}
.legend-core.data-v-ce9408c1,
.legend-node.data-v-ce9408c1 {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.legend-core.data-v-ce9408c1 {
  background: var(--accent-strong);
}
.legend-node.data-v-ce9408c1 {
  margin-left: 6px;
  border: 1px solid var(--accent);
  background: var(--card);
}

/* ══ 节（Section） ══ */
.section-block.data-v-ce9408c1 {
  border-top: 1px solid var(--card-soft);
}
.section-head.data-v-ce9408c1 {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 14px;
}
.section-marker.data-v-ce9408c1 {
  display: flex;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 11px;
  font-weight: 800;
}
.section-copy.data-v-ce9408c1 {
  gap: 3px;
}
.section-title.data-v-ce9408c1 {
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
}
.section-meta.data-v-ce9408c1 {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 11px;
}

/* ══ 知识点（Point） ══ */
.point-block.data-v-ce9408c1 {
  border-top: 1px dashed var(--card-soft);
}
.point-head.data-v-ce9408c1 {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 14px 9px 32px;
  background: var(--card-soft);
}
.point-num.data-v-ce9408c1 {
  display: flex;
  width: 25px;
  height: 25px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
  background: var(--card);
  color: var(--accent-strong);
  font-size: 11px;
  font-weight: 800;
}
.point-copy.data-v-ce9408c1 {
  gap: 3px;
}
.point-title.data-v-ce9408c1 {
  color: var(--text);

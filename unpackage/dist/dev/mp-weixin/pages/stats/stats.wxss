.stats.data-v-3598459f {
  min-height: 100vh;
}
.stats-header.data-v-3598459f {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: calc(env(safe-area-inset-top, 0px) + var(--status-bar-height, 0px) + 10px) 16px 12px;
}
.stats-main.data-v-3598459f {
  padding: 8px 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.stats-lead.data-v-3598459f {
  padding: 17px 18px 15px;
}
.stats-lead-top.data-v-3598459f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.stats-lead-copy.data-v-3598459f {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}
.stats-lead-kicker.data-v-3598459f {
  color: var(--accent-strong);
  font-size: 12px;
  font-weight: 800;
}
.stats-lead-title.data-v-3598459f {
  color: var(--text);
  font-size: 17px;
  font-weight: 700;
}
.stats-lead-percent.data-v-3598459f {
  color: var(--accent-strong);
  font-size: 24px;
  font-weight: 800;
}
.stats-lead .progress-track.data-v-3598459f {
  margin-top: 14px;
}
.stats-lead-sub.data-v-3598459f {
  display: block;
  margin-top: 10px;
  color: var(--muted);
  font-size: 12px;
}
.kpi-grid.data-v-3598459f {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.kpi.data-v-3598459f {
  width: calc(50% - 6px);
  box-sizing: border-box;
  min-height: 88px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.kpi-num.data-v-3598459f {
  font-size: 28px;
  font-weight: 800;
  color: var(--accent-strong);
}
.kpi-label.data-v-3598459f {
  font-size: 13px;
  color: var(--muted);
}
.chart-card.data-v-3598459f {
  padding: 18px;
}
.card-title.data-v-3598459f {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 12px;
  color: var(--text);
  display: block;
}
.chart-sub.data-v-3598459f {
  margin-top: 10px;
  font-size: 12px;
  color: var(--muted);
  display: block;
}
.progress-track.data-v-3598459f {
  height: 10px;
  border-radius: 999px;
  background: var(--card-soft);
  overflow: hidden;
}
.progress-fill.data-v-3598459f {
  height: 100%;
  border-radius: 999px;
  background: var(--accent-strong);
  transition: width 0.3s ease;
}
.week-bars.data-v-3598459f {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  height: 96px;
  padding: 0 4px;
}
.week-col.data-v-3598459f {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  height: 100%;
  justify-content: flex-end;
}

/* 无记录日为低柱、有记录日为高柱点亮，一眼看出活跃节奏 */
.bar.data-v-3598459f {
  display: flex;
  width: 100%;
  max-width: 26px;
  height: 18px;
  align-items: center;
  justify-content: center;
  border-radius: 7px;
  background: var(--card-soft);
  transition: height 0.25s ease;
}
.bar.on.data-v-3598459f {
  height: 56px;
  border: 1px solid var(--accent);
  background: var(--accent-soft);
}
.bar-check.data-v-3598459f {
  color: var(--accent-strong);
  font-size: 16px;
  font-weight: 800;
}
.week-label.data-v-3598459f {
  font-size: 12px;
  color: var(--muted);
}
.week-label.today.data-v-3598459f {
  color: var(--accent-strong);
  font-weight: 700;
}
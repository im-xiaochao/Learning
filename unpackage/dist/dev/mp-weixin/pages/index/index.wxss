/* 首页纵向布局：顶部尊重状态栏，底部主行动贴近原生 TabBar。 */
.home.data-v-1cf27b2a {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  gap: 10px;
  padding: calc(env(safe-area-inset-top, 0px) + var(--status-bar-height, 0px) + 24px) 16px calc(12px + env(safe-area-inset-bottom, 0px));
  overflow: visible;
  box-sizing: border-box;
}







/* 顶栏全部左对齐，右侧为微信胶囊保留安全空间。 */
.home-top.data-v-1cf27b2a {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 12px;
}
.home-heading.data-v-1cf27b2a {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 1px;
}
.home-title-row.data-v-1cf27b2a {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 8px;
}
.home-kicker.data-v-1cf27b2a {
  color: var(--accent-strong);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
}
.home-title.data-v-1cf27b2a {
  color: var(--text);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 0.5px;
  line-height: 1.2;
}
.home-status.data-v-1cf27b2a {
  overflow: hidden;
  flex-shrink: 1;
  color: var(--muted);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 今日一词：固定为更舒展的视觉重点，不参与剩余空间分配。 */
.daily.data-v-1cf27b2a {
  display: flex;
  flex: 0 0 230px;
  flex-direction: column;
  gap: 6px;
  padding: 12px 16px;
  overflow: hidden;
  border-left: 4px solid var(--accent);
  background: var(--card-raised);
}
.daily-top.data-v-1cf27b2a {
  display: flex;
  flex-shrink: 0;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.daily-label.data-v-1cf27b2a {
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
}
.daily-mark.data-v-1cf27b2a {
  padding: 3px 7px;
  border-radius: 7px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 10px;
  font-weight: 700;
}
.daily-main.data-v-1cf27b2a {
  display: flex;
  flex: 1 1 auto;
  min-height: 0;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
}
.daily-word.data-v-1cf27b2a {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px;
}
.daily-word-text.data-v-1cf27b2a {
  color: var(--accent-strong);
  font-size: 26px;
  font-weight: 800;
  letter-spacing: 0.2px;
  line-height: 1.2;
}
.daily-phonetic.data-v-1cf27b2a {
  color: var(--accent);
  font-size: 13px;
}
.daily-meaning.data-v-1cf27b2a {
  color: var(--text);
  font-size: 14px;
  line-height: 1.45;
}

/* 进度卡 */
.progress-card.data-v-1cf27b2a {
  display: flex;
  flex: 0 0 102px;
  min-height: 102px;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px 16px 11px;
}
.progress-top.data-v-1cf27b2a,
.progress-bottom.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.progress-label.data-v-1cf27b2a {
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.progress-percent.data-v-1cf27b2a {
  color: var(--accent-strong);
  font-size: 20px;
  font-weight: 800;
}
.progress-track.data-v-1cf27b2a {
  height: 8px;
  margin-top: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: var(--card-soft);
}
.progress-fill.data-v-1cf27b2a {
  height: 100%;
  border-radius: 999px;
  background: var(--accent-strong);
  transition: width 0.3s ease;
}
.progress-bottom.data-v-1cf27b2a {
  margin-top: 8px;
}
.progress-num.data-v-1cf27b2a {
  color: var(--muted);
  font-size: 13px;
}
.progress-num-b.data-v-1cf27b2a {
  color: var(--text);
  font-size: 18px;
  font-weight: 800;
}
.progress-tip.data-v-1cf27b2a {
  color: var(--muted);
  font-size: 11px;
}

/* 每组词数设置 */
.settings-card.data-v-1cf27b2a {
  display: flex;
  flex: 0 0 70px;
  min-height: 70px;
  align-items: center;
  justify-content: space-between;
  gap: 8px 12px;
  padding: 10px 16px;
}
.settings-copy.data-v-1cf27b2a {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2px;
}
.settings-label.data-v-1cf27b2a {
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.settings-helper.data-v-1cf27b2a {
  color: var(--muted);
  font-size: 11px;
}
.size-stepper.data-v-1cf27b2a {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 7px;
}
.step-btn.data-v-1cf27b2a {
  display: flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--card-soft);
  color: var(--accent-strong);
  font-size: 21px;
  font-weight: 700;
}
.step-btn.disabled.data-v-1cf27b2a {
  opacity: 0.35;
}
.size-input.data-v-1cf27b2a {
  width: 54px;
  height: 40px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--card);
  color: var(--text);
  font-size: 16px;
  font-weight: 700;
  text-align: center;
}

/* 快捷入口 */
.quick-row.data-v-1cf27b2a {
  display: flex;
  flex: 0 0 110px;
  min-height: 110px;
  align-items: stretch;
  gap: 10px;
}
.quick-btn.data-v-1cf27b2a {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 9px;
  padding: 10px 12px;
}
.quick-mark.data-v-1cf27b2a {
  display: flex;
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 800;
}
.quick-mark-wrong.data-v-1cf27b2a {
  background: var(--danger-soft);
  color: var(--danger);
}
.quick-mark-stats.data-v-1cf27b2a {
  background: var(--accent-soft);
  color: var(--accent-strong);
}
.quick-copy.data-v-1cf27b2a {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 1px;
}
.quick-main.data-v-1cf27b2a {
  color: var(--text);
  font-size: 14px;
  font-weight: 700;
}
.quick-sub.data-v-1cf27b2a {
  overflow: hidden;
  color: var(--muted);
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 学习主行动 */
.learn-btn.data-v-1cf27b2a {
  display: flex;
  flex-shrink: 0;
  min-height: 60px;
  margin-top: auto;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 16px 10px 18px;
  border-radius: var(--radius);
  background: var(--accent-strong);
  box-shadow: var(--shadow-lg);
}
.learn-btn-copy.data-v-1cf27b2a,
.review-copy.data-v-1cf27b2a {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 2px;
}
.learn-main.data-v-1cf27b2a {
  color: var(--on-accent);
  font-size: 19px;
  font-weight: 800;
}
.learn-sub.data-v-1cf27b2a {
  color: var(--on-accent-muted);
  font-size: 11px;
}
.learn-arrow.data-v-1cf27b2a,
.review-arrow.data-v-1cf27b2a {
  flex-shrink: 0;
  font-size: 26px;
  line-height: 1;
}
.learn-arrow.data-v-1cf27b2a {
  color: var(--on-accent);
}

/* 复习入口 */
.review-btn.data-v-1cf27b2a {
  display: flex;
  flex-shrink: 0;
  min-height: 50px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 16px;
}
.review-main.data-v-1cf27b2a {
  color: var(--accent-strong);
  font-size: 15px;
  font-weight: 800;
}
.review-sub.data-v-1cf27b2a {
  overflow: hidden;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.review-arrow.data-v-1cf27b2a {
  color: var(--accent-strong);
}
.all-done.data-v-1cf27b2a {
  display: flex;
  flex-shrink: 0;
  margin-top: auto;
  align-items: center;
  gap: 10px;
  padding: 16px;
  color: var(--text);
  font-size: 15px;
  font-weight: 700;
}
.all-done-icon.data-v-1cf27b2a {
  display: flex;
  width: 30px;
  height: 30px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--success-soft);
  color: var(--success);
  font-size: 18px;
  font-weight: 800;
}
.quick-btn.data-v-1cf27b2a:active,
.review-btn.data-v-1cf27b2a:active,
.learn-btn.data-v-1cf27b2a:active,
.step-btn.data-v-1cf27b2a:active {
  opacity: 0.76;
  transform: scale(0.98);
}

/* 小屏进一步压缩，优先保证主要内容可见 */
@media (max-height: 660px) {
.home.data-v-1cf27b2a { gap: 7px;
}
.daily.data-v-1cf27b2a {
    flex-basis: 170px;
}
.home-title.data-v-1cf27b2a {
    font-size: 20px;
}
.daily-word-text.data-v-1cf27b2a {
    font-size: 26px;
}
.progress-card.data-v-1cf27b2a {
    flex-basis: 86px;
    min-height: 86px;
    padding: 10px 14px 9px;
}
.progress-track.data-v-1cf27b2a {
    margin-top: 8px;
}
.progress-bottom.data-v-1cf27b2a {
    margin-top: 6px;
}
.settings-card.data-v-1cf27b2a {
    flex-basis: 56px;
    min-height: 56px;
    padding: 8px 14px;
}
.quick-row.data-v-1cf27b2a {
    flex-basis: 86px;
    min-height: 86px;
}
.quick-btn.data-v-1cf27b2a {
    padding: 8px 10px;
}
.quick-mark.data-v-1cf27b2a {
    width: 24px;
    height: 24px;
}
.learn-btn.data-v-1cf27b2a {
    min-height: 54px;
}
.review-btn.data-v-1cf27b2a {
    min-height: 46px;
}
}
@media (max-width: 340px) {
.home.data-v-1cf27b2a {
    padding-right: 12px;
    padding-left: 12px;
}
.size-stepper.data-v-1cf27b2a {
    gap: 4px;
}
.step-btn.data-v-1cf27b2a {
    width: 36px;
}
.size-input.data-v-1cf27b2a {
    width: 48px;
}
}
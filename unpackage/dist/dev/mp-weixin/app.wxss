/* ══ 全局样式（App.vue 为全局作用域） ══ */
page {
  background: #f5f7fb;
  color: #182231;
  margin: 0;
  padding: 0;
}

/* 统一盒模型：全局元素选择器（不依赖页面类名），修复 width:100% + padding 溢出 */
view,
text,
button,
input,
image,
textarea {
  box-sizing: border-box;
}




















/* 全局色彩变量：挂页面根节点（小程序无 :root） */
.page {
  --bg: #f5f7fb;
  --card: #ffffff;
  --card-soft: #eef1f7;
  --card-raised: #fafbff;
  --text: #182231;
  --muted: #5c6879;
  --accent: #3855d8;
  --accent-strong: #2c42b5;
  --accent-soft: #e9edff;
  --success: #117a5b;
  --success-soft: #e2f5ef;
  --danger: #b4233c;
  --danger-soft: #fdebed;
  --warning: #975b00;
  --warning-soft: #fff4db;
  --border: #dce2ec;
  --on-accent: #ffffff;
  --on-accent-muted: rgba(255, 255, 255, 0.78);
  --shadow: 0 8px 24px rgba(24, 34, 49, 0.06);
  --shadow-lg: 0 12px 26px rgba(44, 66, 181, 0.2);
  --radius: 18px;
  --radius-sm: 12px;

  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  box-sizing: border-box;
  font-family:
    system-ui,
    -apple-system,
    'PingFang SC',
    'HarmonyOS Sans SC',
    'Microsoft YaHei',
    'Segoe UI',
    Roboto,
    sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

/* 通用页头：返回键 + 标题（stats / wrong 等子页共用） */
.back-btn {
  display: flex;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--card);
  box-shadow: var(--shadow);
}
.back-text {
  color: var(--text);
  font-size: 24px;
  font-weight: 700;
  line-height: 1;
}
.page-title {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}
.title-text {
  color: var(--text);
  font-size: 20px;
  font-weight: 800;
}
.page-sub {
  color: var(--muted);
  font-size: 12px;
}

/* 按压反馈：微信小程序 WXSS 不支持 :active，可点击元素统一用 hover-class="hover-press" */
.hover-press {
  opacity: 0.72;
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  border-radius: 16px;
  font-size: 17px;
  font-weight: 600;
}
.btn-primary {
  background: var(--accent-strong);
  color: var(--on-accent);
  box-shadow: var(--shadow-lg);
}
.btn-ghost {
  background: var(--card-soft);
  color: var(--text);
}
.btn-block {
  width: 100%;
}

/* 入场动画（小程序不支持 Transition 组件，改用 keyframes） */
@keyframes uniFade {
from {
    opacity: 0;
    transform: translateY(8px);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
.fade-in {
  animation: uniFade 0.18s ease both;
}

/* 可访问性：系统开启“减弱动态效果”时，不让反馈依赖动画。 */
@media (prefers-reduced-motion: reduce) {
.fade-in {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
}
}
